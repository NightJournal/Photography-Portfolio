.DS_Store
Dolomites Planning/

# Font source archives. The CSS loads the extracted .otf/.ttf in fonts/<name>/,
# so the zips are redundant in Git. They stay on local disk.
fonts/*.zip

# Local tooling and the .git backup taken during the history rewrite.
.claude/
.git-backup-*/

# Photo inbox: captions.txt templates are tracked, dropped originals are not.
photos/_inbox/**/*.jpg
photos/_inbox/**/*.jpeg
photos/_inbox/**/*.JPG
photos/_inbox/_processed/
